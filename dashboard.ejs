<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard</title><link rel="stylesheet" href="/style.css"></head><body><div class="top"><div><b>İSG Uzmanı</b><br><small><%=user.name%></small></div><form method="post" action="/logout"><button class="btn gray">Çıkış</button></form></div><div class="wrap"><div class="actions no-print"><a class="btn" href="/companies/new">+ İşletme ekle</a></div><h2>İşletmeler</h2><div class="grid"><% companies.forEach(c=>{%><div class="card"><h3><%=c.name%></h3><p class="muted"><%=c.nace||'NACE girilmedi'%> · <%=c.hazard||'Tehlike sınıfı yok'%></p><div class="pill"><%=c.employees%> çalışan</div><div class="actions"><a class="btn" href="/companies/<%=c.id%>">İşletmeyi aç</a></div></div><%})%></div><% if(!companies.length){%><div class="card"><p>Henüz işletme eklenmedi.</p></div><%}%></div></body></html>