<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%=c.name%></title><link rel="stylesheet" href="/style.css"></head><% function expertText(c){const n=c.employees||0,h=c.hazard||'';const m=h==='Az Tehlikeli'?6:h==='Tehlikeli'?8:h==='Çok Tehlikeli'?12:0;const t=h==='Az Tehlikeli'?2000:h==='Tehlikeli'?1500:h==='Çok Tehlikeli'?1000:0;if(!m)return '—';if(n>=t){const full=Math.floor(n/t),rem=n%t;return full+' tam zamanlı'+(rem?' + '+(rem*m)+' dk/ay':'')}return (n*m)+' dk/ay'} function doctorText(c){const n=c.employees||0,h=c.hazard||'';const m=h==='Az Tehlikeli'?5:h==='Tehlikeli'?10:h==='Çok Tehlikeli'?15:0;const t=h==='Az Tehlikeli'?2000:h==='Tehlikeli'?1000:h==='Çok Tehlikeli'?750:0;if(!m)return '—';if(n>=t){const full=Math.floor(n/t),rem=n%t;return full+' tam zamanlı'+(rem?' + '+(rem*m)+' dk/ay':'')}return (n*m)+' dk/ay'} function supportCount(n,h){if(!n)return 0;return h==='Çok Tehlikeli'?Math.ceil(n/30):h==='Tehlikeli'?Math.ceil(n/40):Math.ceil(n/50)} %><body><div class="top"><div><b><%=c.name%></b><br><small><%=c.nace||'NACE yok'%> · <%=c.hazard||'Tehlike sınıfı yok'%> · <%=c.employees%> çalışan</small></div><div class="actions no-print"><a class="btn gray" href="/dashboard">Dashboard</a><button class="btn gray" onclick="window.print()">PDF / Yazdır</button><a class="btn gray" href="/api/companies/<%=c.id%>/backup">JSON Yedek</a></div></div><div class="wrap"><div class="nav no-print"><a class="pill" href="#hesap">Hesaplama</a><a class="pill" href="#risk">Risk</a><a class="pill" href="#emergency">Acil Durum</a><a class="pill" href="#finding">Uygunsuzluk</a></div>
<div class="grid" id="hesap"><div class="card"><div class="muted">İSG Uzmanı</div><div class="kpi"><%= expertText(c) %></div></div><div class="card"><div class="muted">İşyeri Hekimi</div><div class="kpi"><%= doctorText(c) %></div></div><div class="card"><div class="muted">Destek elemanı</div><div class="kpi"><%= supportCount(c.employees,c.hazard) %></div></div></div>
<div class="card"><h2>İşletme Özeti</h2><p><b>Faaliyet:</b> <%=c.activity||'—'%> · <b>Çalışma:</b> <%=c.work_type||'—'%></p><p><b>Adres:</b> <%=c.address||'—'%> · <b>İşyeri hekimi:</b> <%=c.doctor||'—'%></p><div class="warn">NACE ve tehlike sınıfını resmi güncel listeden doğrulayın. Risk değerlendirmesi işletmenin fiili koşullarına göre tamamlanmalıdır.</div></div>
<div class="card" id="risk"><h2>Risk Değerlendirmesi</h2><form method="post" action="/companies/<%=c.id%>/risk"><div class="two"><div><label>Bölüm / faaliyet</label><input name="section"><label>Tehlike</label><input name="hazard"><label>Risk</label><textarea name="risk"></textarea><label>Önlem</label><textarea name="control"></textarea></div><div><label>Yöntem</label><select name="method"><option>5x5</option><option>Fine-Kinney</option></select><label>Olasılık</label><input name="p" type="number" value="1"><label>Frekans</label><input name="f" type="number" value="1"><label>Şiddet</label><input name="s" type="number" value="1"><label>Termin</label><input name="due" type="date"></div></div><div class="actions"><button class="btn">Risk ekle</button></div></form><table><tr><th>Faaliyet</th><th>Tehlike / Risk</th><th>Skor</th><th>Önlem</th><th>Termin</th></tr><% risks.forEach(r=>{let score=r.method==='Fine-Kinney'?r.p*r.f*r.s:r.p*r.s;%><tr><td><%=r.section%></td><td><%=r.hazard%><br><%=r.risk%></td><td><b><%=score%></b></td><td><%=r.control%></td><td><%=r.due||''%></td></tr><%})%></table></div>
<div class="card" id="emergency"><h2>Acil Durum Eylem Planı</h2><form method="post" action="/companies/<%=c.id%>/emergency"><div class="two"><div><label>Acil durum</label><input name="name" placeholder="Yangın / Deprem / Kimyasal sızıntı"><label>Önleyici tedbir</label><textarea name="prevent"></textarea><label>Müdahale / tahliye</label><textarea name="response"></textarea></div><div><label>Sorumlu</label><input name="owner"><label>Tatbikat tarihi</label><input name="drill" type="date"></div></div><div class="actions"><button class="btn">Ekle</button></div></form><table><tr><th>Acil durum</th><th>Önlem</th><th>Müdahale</th><th>Sorumlu</th><th>Tatbikat</th></tr><% emergencies.forEach(e=>{%><tr><td><%=e.name%></td><td><%=e.prevent%></td><td><%=e.response%></td><td><%=e.owner%></td><td><%=e.drill||''%></td></tr><%})%></table></div>
<div class="card" id="finding"><h2>Denetim / Uygunsuzluk</h2><form method="post" action="/companies/<%=c.id%>/finding"><div class="two"><div><label>Alan</label><input name="area"><label>Uygunsuzluk</label><textarea name="issue"></textarea><label>Mevzuat / referans</label><input name="ref"><label>Düzeltici faaliyet</label><textarea name="fix"></textarea></div><div><label>Risk düzeyi</label><select name="risk"><option>Düşük</option><option>Orta</option><option>Yüksek</option><option>Çok Yüksek</option></select><label>Termin</label><input name="due" type="date"><label>Durum</label><select name="status"><option>Açık</option><option>Devam ediyor</option><option>Kapandı</option></select></div></div><div class="actions"><button class="btn">Uygunsuzluk ekle</button></div></form><table><tr><th>Alan</th><th>Uygunsuzluk</th><th>Referans</th><th>Risk</th><th>Faaliyet</th><th>Termin</th><th>Durum</th></tr><% findings.forEach(f=>{%><tr><td><%=f.area%></td><td><%=f.issue%></td><td><%=f.ref%></td><td><%=f.risk%></td><td><%=f.fix%></td><td><%=f.due||''%></td><td><%=f.status%></td></tr><%})%></table></div>
<div class="card no-print"><form method="post" action="/companies/<%=c.id%>/delete" onsubmit="return confirm('İşletme ve kayıtları silinsin mi?')"><button class="btn red">İşletmeyi sil</button></form></div></div></body></html>