<!doctype html><html lang="tr"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>İşletme</title><link rel="stylesheet" href="/style.css"></head><body><div class="top"><b>İSG Uzmanı / İşletme</b><a class="btn gray" href="/dashboard">Dashboard</a></div><div class="wrap"><div class="card"><h1>İşletme ekle</h1><% if(error){%><div class="err"><%=error%></div><%}%><form method="post" action="/companies"><div class="two"><div><label>İşletme unvanı</label><input name="name" required><label>SGK sicil no</label><input name="sgk"><label>İşveren / yetkili</label><input name="employer"><label>Çalışan sayısı</label><input name="employees" type="number" min="0" value="0"><label>NACE 6'lı kod</label><input name="nace"></div><div><label>Tehlike sınıfı</label><select name="hazard"><option value="">Seçiniz</option><option>Az Tehlikeli</option><option>Tehlikeli</option><option>Çok Tehlikeli</option></select><label>Faaliyet</label><select name="activity"><option>Ofis / Büro</option><option>Restoran / Kafe</option><option>Market / Perakende</option><option>Otel / Konaklama</option><option>Oto Servis / Bakım</option><option>Depo / Lojistik</option><option>Metal İmalat</option><option>Ahşap / Mobilya</option><option>İnşaat</option><option>Sağlık Kuruluşu</option><option>Eğitim Kurumu</option><option>Akaryakıt İstasyonu</option><option>Tekstil</option><option>Gıda İmalatı</option><option>Kimyasal Madde Kullanılan İşletme</option></select><label>Adres</label><input name="address"><label>İşyeri hekimi</label><select name="doctor"><option>Evet</option><option>Hayır</option></select><label>İSG uzmanı sınıfı</label><select name="expert_class"><option>A</option><option>B</option><option>C</option></select><label>Çalışma şekli</label><select name="work_type"><option>Gündüz</option><option>Vardiyalı</option><option>Gece çalışması var</option></select></div></div><div class="actions"><button class="btn">Kaydet</button></div></form></div></div></body></html>